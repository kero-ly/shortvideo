  "shots": [
    {
      "id": "shot-01",
      "narration": "怀孕第1周，通常还没受精？看懂这12周，也看见妈妈的辛苦。",
      "sources": [
        "acog",
        "nhs-4"
      ]
    },
    {
      "id": "shot-02",
      "narration": "孕周从末次月经第一天算，不是从受精那天算。",
      "sources": [
        "acog",
        "nhs-4"
      ]
    },
    {
      "id": "shot-03",
      "narration": "第2周，身体为排卵做准备。周期不同，排卵时间也不同。",
      "sources": [
        "acog",
        "nhs-4"
      ]
    },
    {
      "id": "shot-04",
      "narration": "第3周前后，可能发生受精。细胞分裂，随后向子宫移动。",
      "sources": [
        "acog"
      ]
    },
    {
      "id": "shot-05",
      "narration": "到第4周前后，着床通常已经发生，但你可能还没有明显感觉。",
      "sources": [
        "acog",
        "nhs-4"
      ]
    },
    {
      "id": "shot-06",
      "narration": "第5周，脑、脊髓和心脏正在发育。停经、犯困，也可能让你发现怀孕。",
      "sources": [
        "nhs-5"
      ]
    },
    {
      "id": "shot-07",
      "narration": "第6周，四肢芽开始出现。恶心可能找上门，而且不只发生在早晨。",
      "sources": [
        "nhs-6",
        "nhs-nausea"
      ]
    },
    {
      "id": "shot-08",
      "narration": "第7周，脑部快速发育，小胳膊继续长。妈妈可能依然很累。",
      "sources": [
        "nhs-7",
        "nhs-nausea"
      ]
    },
    {
      "id": "shot-09",
      "narration": "第8周，四肢继续发育。闻到饭味就难受，真的不是矫情。",
      "sources": [
        "nhs-8",
        "nhs-nausea"
      ]
    },
    {
      "id": "shot-10",
      "narration": "第9周，面部轮廓更清楚，手脚继续发育。孕吐和疲倦可能还在。",
      "sources": [
        "nhs-9",
        "nhs-nausea"
      ]
    },
    {
      "id": "shot-11",
      "narration": "第10周，宝宝已经有小动作，但妈妈通常还感觉不到胎动。",
      "sources": [
        "nhs-10",
        "nhs-11"
      ]
    },
    {
      "id": "shot-12",
      "narration": "第11周，小手指、脚趾逐渐分开，身体仍在快速成长。",
      "sources": [
        "nhs-11"
      ]
    },
    {
      "id": "shot-13",
      "narration": "第12周，头臀长大约五厘米。器官还在发育，产检继续按医生安排。",
      "sources": [
        "nhs-12",
        "acog"
      ]
    },
    {
      "id": "shot-14",
      "narration": "准爸爸能做的：分担家务，准备她吃得下的小餐，陪她休息、产检。",
      "sources": [
        "nhs-nausea"
      ]
    },
    {
      "id": "shot-15",
      "narration": "每个人反应不同。出血、明显腹痛，或吐到喝不进水，要及时就医。",
      "sources": [
        "nhs-4",
        "nhs-nausea"
      ]
    },
    {
      "id": "shot-16",
      "narration": "肚子还没显出来，不代表她不辛苦。收藏对照孕周，转给陪你迎接宝宝的人。",
      "sources": [
        "nhs-4",
        "nhs-nausea"
      ]
    }
  ],
