      "kind": "calendar",
      "number": "01",
      "start": 187,
      "frames": 122
    },
    {
      "id": "s02",
      "title": "比平时更容易累",
      "note": "给自己一点休息的时间",
      "text": "第二，容易累。平常做完不费力的事，也想坐下来歇一歇。",
      "kind": "tired",
      "number": "02",
      "start": 309,
      "frames": 115
    },
    {
      "id": "s03",
      "title": "乳房胀痛或敏感",
      "note": "经前也可能出现",
      "text": "第三，乳房胀痛或变得敏感。不过，经前也可能这样。",
      "kind": "sensitive",
      "number": "03",
      "start": 424,
      "frames": 108
    },
    {
      "id": "s04",
      "title": "恶心",
      "note": "不一定只在早晨出现",
      "text": "第四，恶心。它不一定只在早晨出现。",
      "kind": "nausea",
      "number": "04",
      "start": 532,
      "frames": 98
    },
    {
      "id": "s05",
      "title": "对气味更敏感",
      "note": "熟悉的味道，也可能变了感觉",
      "text": "第五，对气味更敏感。熟悉的味道，突然觉得受不了。",
      "kind": "smell",
      "number": "05",
      "start": 630,
      "frames": 107
    },
    {
      "id": "s06",
      "title": "小便次数增多",
      "note": "留意和平时相比的变化",
      "text": "第六，上厕所比平时频繁，尤其是小便次数增多。",
      "kind": "bathroom",
      "number": "06",
      "start": 737,
      "frames": 112
    },
    {
      "id": "s07",
      "title": "口味变化",
      "note": "以前爱吃的，现在未必想吃",
      "text": "第七，口味变了。以前爱吃的食物，现在可能不想碰。",
      "kind": "food",
      "number": "07",
      "start": 849,
      "frames": 105
    },
    {
      "id": "s08",
      "title": "情绪起伏",
      "note": "对自己的感受温柔一点",
      "text": "第八，情绪起伏比平时明显，也可能只是众多变化之一。",
      "kind": "mood",
      "number": "08",
      "start": 954,
      "frames": 125
    },
    {
      "id": "truth",
      "title": "症状不是答案",
      "note": "不用数自己“中了几条”",
      "text": "但请记住，有几条都不能直接说明怀孕，没有这些反应也不能排除。最可靠的下一步，是按说明做一次验孕。",
      "kind": "truth",
      "start": 1079,
      "frames": 225
    },
    {
      "id": "test1",
      "title": "什么时候测？",
      "note": "按验孕工具说明操作",
      "text": "通常从月经推迟的第一天开始测。如果不知道月经什么时候来，就在上次无保护性行为至少二十一天后测。",
      "kind": "test",
      "start": 1304,
      "frames": 218
    },
    {
      "id": "test2",
      "title": "阴性，但月经还没来？",
      "note": "太早测，结果可能不可靠",
      "text": "测得太早是阴性，月经又没来？过几天再测一次。第二次仍是阴性、月经还没来，可以咨询医生。",
      "kind": "retest",
      "start": 1522,
      "frames": 187
    },
    {
      "id": "care",
      "title": "这些情况，请及时就医",
      "note": "明显腹痛 · 阴道出血",
      "text": "要是出现明显腹痛或阴道出血，请及时就医。先确认，再决定下一步，不用一个人靠猜。",
      "kind": "care",
      "start": 1709,
      "frames": 201
    }
